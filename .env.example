# ローカル実行用。.env にコピーして値を入れる（.env はコミットしない）
# 名前は GitHub の Secrets / Variables と同じにしている

# --- Secrets ---
ANTHROPIC_API_KEY=
# サブスクリプションで使う場合は ANTHROPIC_API_KEY の代わりにこちら（claude setup-token で発行）
# CLAUDE_CODE_OAUTH_TOKEN=
BACKLOG_API_KEY=
ELEVENLABS_API_KEY=
PIXELLAB_API_KEY=
RUNWAYML_API_SECRET=

# --- Variables ---
BACKLOG_DOMAIN=example.backlog.com
BACKLOG_PROJECT_KEY=AISTUDYDEMO
BACKLOG_DONE_STATUS_ID=4
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
