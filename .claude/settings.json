{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["backlog"],
  "permissions": {
    "allow": [
      "mcp__backlog__get_issue",
      "mcp__backlog__get_issues",
      "mcp__backlog__get_issue_comments",
      "mcp__backlog__get_project",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm run build:app)",
      "Bash(npm run check:env)",
      "Bash(npm run pipeline:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch -c feature/:*)",
      "Bash(git checkout -b feature/:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)"
    ]
  }
}
